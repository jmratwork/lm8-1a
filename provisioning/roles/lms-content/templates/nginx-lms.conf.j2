server {
    listen {{ lms_content_port }};
    server_name lms.internal _;

    root {{ lms_content_web_root }};
    index index.html;

    access_log /var/log/nginx/lms_access.log;
    error_log  /var/log/nginx/lms_error.log;

    location / {
        try_files $uri $uri/ =404;
    }

    # Detection reports from the Practical Exercise form. Proxied to the GoPhish
    # phishing server's report endpoint so the form stays same-origin and can tell
    # a recorded report (204) from an unknown reference (404); the ?rid= query
    # string is passed through. No variables in proxy_pass: the host must resolve
    # from /etc/hosts at load time, which a runtime resolver would not consult.
    location = /gophish-report {
        limit_except GET { deny all; }
        proxy_pass {{ lms_content_gophish_report_url }};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
}
